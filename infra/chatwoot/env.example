# Copiá este archivo a .env (install.sh lo hace y genera los secretos solo).
# NUNCA subas el .env a GitHub.

CHAT_DOMAIN=chat.nodoscompliance.com
FRONTEND_URL=https://chat.nodoscompliance.com
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=es

# Generados por install.sh
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot
REDIS_URL=redis://redis:6379

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local

# Envío de emails de Chatwoot (invitaciones, recuperar contraseña). Opcional:
# sin esto funciona igual para un solo administrador.
MAILER_SENDER_EMAIL=NODOS <contacto@nodoscompliance.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# Instagram y Facebook Messenger (app propia de Meta, ver README paso 6)
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=

# Asistente de NODOS: se completan después de crear el Agent Bot (README paso 5)
CHATWOOT_BOT_TOKEN=
CHATWOOT_BOT_SECRET=
